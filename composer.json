{
    "name": "portabilis/i-educar",
    "description": "Software livre de gest\u00e3o escolar",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "version": "2.10.0",
    "keywords": [
        "Portabilis",
        "i-Educar"
    ],
    "authors": [
        {
            "name": "Port\u00e1bilis",
            "email": "contato@portabilis.com.br",
            "homepage": "https://portabilis.com.br"
        }
    ],
    "homepage": "https://github.com/portabilis/i-educar",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "ext-zip": "*",
        "ankurk91/laravel-eloquent-relationships": "^2.1",
        "aws/aws-sdk-php-laravel": "^3.7",
        "composer/semver": "^3.2",
        "dex/composer-plug-and-play": "^0.24",
        "dex/frontier": "^0.16.0",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.3",
        "honeybadger-io/honeybadger-laravel": "^4.0",
        "intervention/image": "^2.6",
        "laravel/framework": "^12.5",
        "laravel/horizon": "^5.15",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.6",
        "laravel/ui": "^4.2",
        "league/csv": "^9.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "merenda/merenda-escolar": "2.11.0",
        "phpoffice/phpspreadsheet": "^1.8",
        "predis/predis": "^2.3",
        "psr/simple-cache": "^3.0",
        "smalot/pdfparser": "^2.0",
        "socialiteproviders/laravelpassport": "^4.3",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "symfony/http-client": "^6.0",
        "symfony/mailgun-mailer": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.15",
        "laravel/pint": "^1.10",
        "laravel/sail": "^1.18",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.0",
        "spatie/laravel-ignition": "^2.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "classmap": [
            "ieducar/intranet/include",
            "ieducar/lib",
            "ieducar/modules/*/Model",
            "ieducar/modules/Avaliacao/Service",
            "ieducar/modules/Avaliacao/Views",
            "ieducar/modules/FormulaMedia/Validate",
            "ieducar/modules/RegraAvaliacao/Validators"
        ],
        "files": [
            "ieducar/intranet/include/funcoes.inc.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Custom\\": "database/custom/",
            "Database\\Seeders\\": "database/seeders/",
            "iEducar\\": "src",
            "iEducar\\Packages\\DespesaEscolar\\": "packages/despesas-escolar/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "tests/Unit"
        ]
    },
    "include-path": [
        "ieducar",
        "ieducar/intranet",
        "ieducar/lib",
        "ieducar/modules"
    ],
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope",
                "laravel/sail"
            ]
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "openapi": "vendor/uderline/openapi-php-attributes/opag tests public/openapi.json",
        "set-permissions": "find bootstrap/cache -type d -exec chmod 777 {} + && find storage -type d -exec chmod 777 {} +",
        "new-install": [
            "@composer install",
            "@composer plug-and-play",
            "@set-permissions",
            "@php artisan key:generate --ansi",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --force --ansi"
        ],
        "update-install": [
            "@composer update",
            "@composer plug-and-play",
            "@set-permissions",
            "@php artisan storage:link --ansi",
            "@php artisan migrate --force --ansi"
        ],
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dex/composer-plug-and-play": true,
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "ignore": [
                "PKSA-gz3f-3cz3-3wsw",
                "PKSA-x13r-n4wc-4gcr",
                "PKSA-8cfg-tzhf-fr83",
                "PKSA-hznc-gbby-6w16",
                "PKSA-jtdk-dcr5-f11n"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "merenda",
            "type": "path",
            "url": "packages/merenda/merenda-escolar",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/despesas-escolar"
        }
    ]
}
