ARG PHP_VERSION=8.4
ARG COMPOSER_VERSION=2.8
ARG ENABLE_PACKAGE_REPORTS=false
ARG ENABLE_PACKAGE_EDUCACENSO=false
ARG ENABLE_PACKAGE_TRANSPORTE=false
ARG ENABLE_PACKAGE_PRE_MATRICULA=false
ARG ENABLE_PACKAGE_DESPESAS=false
ARG ENABLE_PACKAGE_MERENDA=false
ARG PACKAGE_REF_REPORTS=
ARG PACKAGE_REF_EDUCACENSO=
ARG PACKAGE_REF_TRANSPORTE=
ARG PACKAGE_REF_PRE_MATRICULA=
ARG PACKAGE_REF_DESPESAS=
ARG PACKAGE_REF_MERENDA=
FROM composer:${COMPOSER_VERSION} AS composer_bin

FROM php:${PHP_VERSION}-fpm-alpine

ARG ENABLE_PACKAGE_REPORTS
ARG ENABLE_PACKAGE_EDUCACENSO
ARG ENABLE_PACKAGE_TRANSPORTE
ARG ENABLE_PACKAGE_PRE_MATRICULA
ARG ENABLE_PACKAGE_DESPESAS
ARG ENABLE_PACKAGE_MERENDA
ARG PACKAGE_REF_REPORTS
ARG PACKAGE_REF_EDUCACENSO
ARG PACKAGE_REF_TRANSPORTE
ARG PACKAGE_REF_PRE_MATRICULA
ARG PACKAGE_REF_DESPESAS
ARG PACKAGE_REF_MERENDA

LABEL maintainer="Portabilis <contato@portabilis.com.br>"

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_PROCESS_TIMEOUT=900
ENV COMPOSER_DISABLE_XDEBUG_WARN=1

COPY --from=composer_bin /usr/bin/composer /usr/local/bin/composer

RUN apk add --no-cache \
    libc-dev \
    libpng-dev \
    libzip-dev \
    linux-headers \
    openjdk8 \
    postgresql17-client \
    postgresql-dev \
    ttf-dejavu \
    unzip \
    openssh \
    git \
    gettext \
    nodejs \
    npm \
    yarn

RUN apk add --no-cache --virtual .phpize_deps $PHPIZE_DEPS

RUN pecl install redis && docker-php-ext-enable redis

RUN docker-php-ext-install \
    bcmath \
    gd \
    pcntl \
    pdo \
    pdo_pgsql \
    pgsql \
    zip \
    ftp

RUN docker-php-ext-enable \
    bcmath \
    gd \
    pcntl \
    pdo \
    pdo_pgsql \
    pgsql \
    zip \
    ftp

RUN apk del .phpize_deps

WORKDIR /var/www/ieducar

COPY --chown=www-data:www-data . /var/www/ieducar

RUN mkdir -p bootstrap/cache \
    && rm -f bootstrap/cache/*.php

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
COPY docker/php/install-extra-packages.sh /usr/local/bin/install-extra-packages.sh

# Token para clones privados: passe com buildx --secret id=git_token,env=GIT_TOKEN
# (nao use --build-arg com token: fica no historico da imagem e aciona SecretsUsedInArgOrEnv).
RUN --mount=type=secret,id=git_token,required=false \
    chmod +x /usr/local/bin/entrypoint.prod.sh /usr/local/bin/install-extra-packages.sh \
    && export GIT_TOKEN="$(cat /run/secrets/git_token 2>/dev/null | tr -d '\n' || true)" \
    && ENABLE_PACKAGE_REPORTS=${ENABLE_PACKAGE_REPORTS} \
    ENABLE_PACKAGE_EDUCACENSO=${ENABLE_PACKAGE_EDUCACENSO} \
    ENABLE_PACKAGE_TRANSPORTE=${ENABLE_PACKAGE_TRANSPORTE} \
    ENABLE_PACKAGE_PRE_MATRICULA=${ENABLE_PACKAGE_PRE_MATRICULA} \
    ENABLE_PACKAGE_DESPESAS=${ENABLE_PACKAGE_DESPESAS} \
    ENABLE_PACKAGE_MERENDA=${ENABLE_PACKAGE_MERENDA} \
    PACKAGE_REF_REPORTS=${PACKAGE_REF_REPORTS} \
    PACKAGE_REF_EDUCACENSO=${PACKAGE_REF_EDUCACENSO} \
    PACKAGE_REF_TRANSPORTE=${PACKAGE_REF_TRANSPORTE} \
    PACKAGE_REF_PRE_MATRICULA=${PACKAGE_REF_PRE_MATRICULA} \
    PACKAGE_REF_DESPESAS=${PACKAGE_REF_DESPESAS} \
    PACKAGE_REF_MERENDA=${PACKAGE_REF_MERENDA} \
    /usr/local/bin/install-extra-packages.sh \
    && rm -f /usr/local/bin/install-extra-packages.sh \
    && rm -f bootstrap/cache/*.php

ENTRYPOINT ["sh", "/usr/local/bin/entrypoint.prod.sh"]
CMD ["php-fpm", "-F"]
