APP_NAME=i-Educar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_TRACK_ERROR=false
APP_DEFAULT_HOST=localhost

ASSETS_SECURE=false

API_ACCESS_KEY=
API_SECRET_KEY=

LEGACY_CODE=true
LEGACY_DISPLAY_ERRORS=false
LEGACY_PATH=ieducar
LOG_CHANNEL=stack
LOG_FILE_PERMISSION=0777

TELESCOPE_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ieducar
DB_USERNAME=ieducar
DB_PASSWORD=ieducar

# Opcional: PostgreSQL externo (ex. i-Diário). Após alterar, rode: php artisan config:cache (ou config:clear).
# DB_HOST_IDIARIO=
# DB_PORT_IDIARIO=5432
# DB_NAME_IDIARIO=
# DB_USER_IDIARIO=
# DB_PASSWORD_IDIARIO=
# DB_SSLMODE_IDIARIO=require
# DB_URL_IDIARIO=

BROADCAST_DRIVER=null
CACHE_STORE=redis
CACHE_TTL=604800
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=localhost
REDIS_CLIENT=predis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=ieducar-

SENTINEL_HOSTS=localhost
SENTINEL_PORT=26379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

HONEYBADGER_API_KEY=

GOOGLE_TAG_MANAGER=

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

MIX_SOCKET_SERVER=127.0.0.1
MIX_SOCKET_PORT=6001

HOST_UID=1001
HOST_GID=1001

# Docker Compose: ao subir fpm/horizon, executa docker/php/install-extra-packages.sh (com lock no volume).
RUN_EXTRA_PACKAGES_INSTALL=false
# true = usa código já baixado em ../ (bind mounts do docker-compose); não clona/fetch remoto.
# USE_LOCAL_PACKAGES=true
# CDN_CONFIG_PATH=/var/www/cdn-config
# Idade máxima (minutos) do diretório de lock antes de ser removido como órfão (ex.: contentor morto a meio do install).
# STALE_EXTRA_PACKAGES_LOCK_MINUTES=45
# Tempo máximo (s) para o Nginx esperar o FPM abrir a porta 9000 (install extra pode demorar vários minutos).
# WAIT_FPM_MAX_SEC=900
# ENABLE_PACKAGE_REPORTS=true
# ENABLE_PACKAGE_EDUCACENSO=true
# ENABLE_PACKAGE_TRANSPORTE=true
# ENABLE_PACKAGE_PRE_MATRICULA=true
# ENABLE_PACKAGE_DESPESAS=true
# ENABLE_PACKAGE_MERENDA=true
# MERENDA_PACKAGE_VERSION=2.11.0
# MERENDA_INSTALL_SCRIPT=packages/merenda/caminho/instalar_modulo.sh

# Código do município/UG no SIAP TCE-AL (cabeçalho de todos os XMLs)
# SIAP_CODIGO=628
# SIAP_KIT_ESCOLAR=2
# SIAP_CODIGO_CARDAPIO=1
# SIAP_DATA_ULTIMA_COMPRA=2025-01-01
# GIT_TOKEN=
# PACKAGE_REF_REPORTS=